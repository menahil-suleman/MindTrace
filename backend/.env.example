# Copy this file to .env and fill in real values. Never commit .env itself.

# Matches docker-compose.yml (db service) for local development
DATABASE_URL=postgresql+asyncpg://appuser:devpassword@localhost:5432/appdb

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Minimum age required to sign up (product requirement: 18+)
MIN_SIGNUP_AGE=18