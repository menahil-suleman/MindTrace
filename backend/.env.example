# Copy this file to .env and fill in real values. Never commit .env itself.

# Matches docker-compose.yml (db service) for local development
DATABASE_URL=postgresql+asyncpg://appuser:devpassword@localhost:5432/appdb

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Minimum age required to sign up (product requirement: 18+)
MIN_SIGNUP_AGE=18

# Brevo (https://app.brevo.com) — used to send "forgot password" OTP emails.
# Leave BREVO_API_KEY blank locally and the code will just be logged to the
# console instead of emailed, so you don't need real credentials to develop/test.
# BREVO_SENDER_EMAIL must be a sender verified in your Brevo account
# (Settings -> Senders, Domains & Dedicated IPs).
BREVO_API_KEY= 
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Mindtrace

# Forgot-password / OTP tuning (defaults shown)
RESET_CODE_EXPIRE_MINUTES=10
RESET_CODE_RESEND_COOLDOWN_SECONDS=45
RESET_CODE_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRE_MINUTES=10